# ─── Database ──────────────────────────────────────────────────────────────
# MySQL connection string (required)
DATABASE_URL=mysql://root:password@localhost:3306/ledgerline

# ─── Authentication ────────────────────────────────────────────────────────
# JWT secret for session tokens (required)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Owner OpenID for admin access
OWNER_OPEN_ID=

# ─── Encryption ────────────────────────────────────────────────────────────
# Master key for AES-256-GCM encryption of API secrets (required in production)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── Binance API (optional - needed for live trading) ──────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ─── Server ────────────────────────────────────────────────────────────────
# Server port (default: 3000)
PORT=3000

# Node environment (development/production)
NODE_ENV=production

# ─── OAuth (optional) ─────────────────────────────────────────────────────
OAUTH_SERVER_URL=

# ─── App ───────────────────────────────────────────────────────────────────
VITE_APP_ID=ledgerline
